# ---- Servidor ----
PORT=3000
# Con IIS como proxy use 127.0.0.1 (el Node solo acepta conexiones del propio servidor)
HOST=0.0.0.0
# Si lo publica bajo un sitio (ej. http://localhost/BEP/) escriba /BEP ; en la raiz deje vacio
BASE_PATH=
# Carpeta del FrontEnd (por defecto: ./public/AppBEP, ya incluido)
FRONT_DIR=./public/AppBEP
# Carpeta donde se guardan los archivos del Flujo de Trabajo
UPLOAD_DIR=./ArchivosBEP

# ---- Seguridad ----
# CAMBIAR en produccion (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Horas de validez de la sesion
SESSION_HOURS=10
# Dias que dura la sesion cuando se marca "Recordar sesion" en el login
REMEMBER_DAYS=30
# true si publicas con HTTPS
COOKIE_SECURE=false
# "completo" muestra el campo Proyecto; "soloBEP" lo oculta
USO_BEP=completo
# (El nombre y el codigo de cada empresa ya no van aqui: se crean desde el portal, ver README)

# ---- Base de datos ----
# mssql (SQL Server) o sqlite (demo sin instalar nada)
DB_CLIENT=mssql
# Instancia con nombre: DB_SERVER=localhost\SQLEXPRESS (deje DB_PORT vacio)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BEP
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Solo para DB_CLIENT=sqlite
SQLITE_FILE=./bep-demo.sqlite
