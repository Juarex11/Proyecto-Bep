<?xml version="1.0" encoding="UTF-8"?>
<!--
  BEP como aplicacion de IIS  ->  http://localhost/BEP/   (igual que SondaV2Portal)

  Desde el modo multiempresa TODO lo atiende el Node de BEP (127.0.0.1:3000):
    /BEP/                 portal (login y eleccion de empresa)
    /BEP/<empresa>/       el sistema de cada empresa (front + datos)
  IIS solo recibe y reenvia (HTTPS, certificado, firewall). No sirve archivos del front.
  Requiere BASE_PATH=/BEP en el .env de BackNode y los modulos URL Rewrite + ARR (proxy activado).
  Si cambia PORT o el alias /BEP, ajuste la linea "action".
  Este archivo va solo en la carpeta de la aplicacion (C:\inetpub\wwwroot\BEP). Lo copia Instalar-BEP-en-IIS.bat.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />   <!-- ignora reglas heredadas del sitio padre -->
        <rule name="BEP-proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/BEP/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 100 MB: subida de archivos del Flujo de Trabajo -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
