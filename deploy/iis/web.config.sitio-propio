<?xml version="1.0" encoding="UTF-8"?>
<!--
  BEP como SITIO PROPIO en IIS (raiz del sitio: https://bep.miempresa.com/).
  Renombre este archivo a web.config y use BASE_PATH vacio en el .env.
  Coloque SOLO este archivo en la carpeta fisica del sitio (ej. C:\inetpub\bep).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="BEP-proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
