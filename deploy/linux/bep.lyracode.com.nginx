# Sitio nginx de BEP.  Copiar a /etc/nginx/sites-available/bep.lyracode.com
# y enlazar en sites-enabled.  Luego:  sudo certbot --nginx -d bep.lyracode.com
# (certbot agrega el bloque HTTPS y la redireccion, igual que en appsonda.lyracode.com)
server {
    listen 80;
    listen [::]:80;
    server_name bep.lyracode.com;

    # Todo (portal, front de cada empresa y API) lo atiende el Node de BEP, que escucha solo en 127.0.0.1:3100
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 70m;      # el Node acepta JSON de hasta 60 MB (subida de archivos)
        proxy_read_timeout 120s;
    }

    access_log /var/log/nginx/bep.access.log;
    error_log  /var/log/nginx/bep.error.log;
}
