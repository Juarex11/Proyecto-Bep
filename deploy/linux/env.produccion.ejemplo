# Copiar a /home/ubuntu/Bep/BackNode/.env en el VPS y completar los CAMBIAR.
# Este archivo NO lleva claves reales; el .env verdadero solo vive en el servidor (chmod 600).
PORT=3100
HOST=127.0.0.1
BASE_PATH=
FRONT_DIR=./public/AppBEP
UPLOAD_DIR=./ArchivosBEP

JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_48
SESSION_HOURS=10
REMEMBER_DAYS=30
COOKIE_SECURE=true
USO_BEP=completo

DB_CLIENT=mssql
DB_SERVER=CAMBIAR_ip_o_nombre_del_sql_server
DB_PORT=1433
DB_NAME=BEP
DB_USER=CAMBIAR_usuario_de_la_base_no_sa
DB_PASSWORD=CAMBIAR
DB_ENCRYPT=true
DB_TRUST_CERT=true
